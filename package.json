{
  "name": "fazenda-infinita",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "client": "vite",
    "server": "node --env-file-if-exists=.env --import tsx --disable-warning=ExperimentalWarning src/server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx --disable-warning=ExperimentalWarning src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bot": "node --env-file-if-exists=.env --import tsx --disable-warning=ExperimentalWarning scripts/bot-vendedor.mts",
    "bot:amigo": "node --import tsx --disable-warning=ExperimentalWarning scripts/bot-amigo.mts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "three": "^0.169.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
